---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/library/Breadcrumbs.astro';
import { SITE, DISCLAIMER, CONTENT_LICENSE_URL } from '../config/site';
import { COURSE } from '../config/course';
import { withBase } from '../lib/base-path';
---

<BaseLayout
  title="About"
  description="About this site — my independent, unofficial handwritten notes from Stanford's public 2018 CS229 course."
>
  <div class="flex max-w-2xl flex-col gap-8">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'About' }]} />

    <div>
      <h1 class="text-3xl sm:text-4xl">About this site</h1>
      <p class="mt-3 text-muted">
        {
          `I'm ${SITE.author}, and I'm working through Stanford's publicly available ${COURSE.editionLabel} recordings of ${COURSE.name} and sharing my handwritten notes here as I go.`
        }
      </p>
      <p class="mt-2 text-muted">
        It's my own independent learning project — a personal record of the course as I study it,
        not an official Stanford resource.
      </p>
    </div>

    <section>
      <h2 class="text-xl">Why I publish these</h2>
      <p class="mt-2 text-muted">
        I keep my notes here so they stay organised and easy to revisit from any device, and so
        there's a public record of the learning as it happens. It's a personal study project, not a
        tutorial or a course replacement.
      </p>
    </section>

    <section>
      <h2 class="text-xl">How it works</h2>
      <p class="mt-2 text-muted">
        Each note is one of my handwritten documents, scanned and published as a PDF with a short
        plain description, the topics it covers, and links to the public course source it relates
        to. Search covers that written metadata only — it does not read the handwriting inside the
        PDFs.
      </p>
      <p class="mt-2 text-muted">
        Course materials referenced:{' '}
        <a href={COURSE.syllabusUrl}>{`${COURSE.name} ${COURSE.editionLabel} syllabus`}</a>{' '}
        and the <a href={COURSE.playlistUrl}>course lecture playlist</a>. This site links to those
        public resources rather than rehosting Stanford videos, slides, official notes, or
        assignments.
      </p>
    </section>

    <section>
      <h2 class="text-xl">Disclaimer</h2>
      <p class="mt-2 text-muted">{DISCLAIMER}</p>
      <p class="mt-2 text-muted">
        These are my notes as a learner. They may contain mistakes, incomplete reasoning, or
        simplifications, and shouldn't be treated as an authoritative reference.
      </p>
    </section>

    <section>
      <h2 class="text-xl">Licensing</h2>
      <p class="mt-2 text-muted">
        The source code for this site is released under the{' '}
        <a href={`${SITE.repoUrl}/blob/main/LICENSE`}>MIT License</a>. My original note content —
        the handwritten notes, scanned PDFs, written descriptions, and derived thumbnails — is{' '}
        {`© ${new Date().getFullYear()} ${SITE.author}, licensed under `}
        <a href={CONTENT_LICENSE_URL}>Creative Commons Attribution 4.0 (CC BY 4.0)</a>. You're free
        to share and adapt it, including commercially, as long as you give appropriate credit, link
        to the license, and note any changes.
      </p>
      <p class="mt-2 text-muted">
        Stanford's course materials, names, and linked videos aren't mine to license and stay with
        their owners. See the{' '}
        <a href={`${SITE.repoUrl}/blob/main/CONTENT-LICENSE.md`}>content license</a> for the full details
        and a suggested attribution line.
      </p>
    </section>

    <section>
      <h2 class="text-xl">Source</h2>
      <p class="mt-2 text-muted">
        The full project — site code and published notes — is on{' '}
        <a href={SITE.repoUrl}>GitHub</a>.
      </p>
      <p class="mt-4">
        <a
          href={withBase('/notes')}
          class="inline-flex items-center gap-2 rounded-md border border-border-strong bg-surface px-4 py-2 font-medium no-underline hover:text-teal"
        >
          Browse the note library →
        </a>
      </p>
    </section>
  </div>
</BaseLayout>
