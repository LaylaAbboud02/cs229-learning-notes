---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProgressBar from '../components/library/ProgressBar.astro';
import NoteGrid from '../components/library/NoteGrid.astro';
import EmptyState from '../components/library/EmptyState.astro';
import { SITE, DISCLAIMER } from '../config/site';
import { withBase } from '../lib/base-path';
import { getListingNotes, featuredNotes, sortByNewest } from '../lib/notes';
import { pluralize } from '../lib/format';
import { NOTE_TYPE_CONFIG } from '../config/note-types';

const notes = await getListingNotes();

// The home highlight surface shows notes flagged `featured`, in course order.
// When nothing is featured it falls back to the most recent notes so the section
// is never empty while notes exist.
const featured = featuredNotes(notes).slice(0, 4);
const highlights = featured.length > 0 ? featured : sortByNewest(notes).slice(0, 4);
const highlightsHeading = featured.length > 0 ? 'Featured notes' : 'Recently added';

const lectureCount = notes.filter((n) => n.type === 'lecture').length;
const exerciseCount = notes.filter((n) => n.type === 'exercise').length;
---

<BaseLayout>
  <div class="flex flex-col gap-16">
    <section class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-start">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold tracking-wide uppercase text-muted">
          Unofficial learning notes by <span class="text-coral-strong">{SITE.author}</span>
        </p>

        <h1 class="mt-3 text-4xl leading-[1.05] sm:text-5xl">{SITE.name}</h1>
        <svg
          class="hero-underline"
          viewBox="0 0 300 12"
          fill="none"
          aria-hidden="true"
          preserveAspectRatio="none"
        >
          <path
            d="M2 8C60 3 150 3 210 6c30 1.5 60 2 88 1"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"></path>
        </svg>

        <p class="mt-4 font-serif text-xl text-ink-soft sm:text-2xl">{SITE.tagline}</p>
        <svg
          class="hero-rule"
          viewBox="0 0 400 8"
          fill="none"
          aria-hidden="true"
          preserveAspectRatio="none"
        >
          <path
            d="M2 4h396"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-dasharray="2 7"></path>
        </svg>

        <p class="mt-6 max-w-prose text-muted">{SITE.description}</p>
        <p class="mt-3 max-w-prose text-sm text-muted">{DISCLAIMER}</p>

        <a
          href={withBase('/notes')}
          class="mt-8 inline-flex items-center gap-2 rounded-md bg-teal-strong px-5 py-3 font-semibold text-white no-underline transition-colors hover:bg-teal"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            aria-hidden="true"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4 4h11l5 5v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Z"></path>
            <path d="M14 4v6h6"></path>
          </svg>
          Browse the notes
        </a>
      </div>

      <aside class="rounded-card border border-border bg-surface p-6 shadow-card">
        <ProgressBar variant="full" />
        <dl class="mt-5 grid grid-cols-2 gap-3 border-t border-border pt-4 text-sm">
          <div>
            <dt class="text-muted">Notes published</dt>
            <dd class="font-serif text-xl text-ink">{notes.length}</dd>
          </div>
          <div>
            <dt class="text-muted">Lecture / exercise</dt>
            <dd class="font-serif text-xl text-ink">{lectureCount} / {exerciseCount}</dd>
          </div>
        </dl>
      </aside>
    </section>

    <section aria-labelledby="home-highlights-heading" data-home-highlights>
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h2 id="home-highlights-heading" class="flex items-center gap-2 text-2xl">
          <svg
            class="text-coral"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            aria-hidden="true"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          >
            <line x1="12" y1="3" x2="12" y2="7"></line>
            <line x1="12" y1="17" x2="12" y2="21"></line>
            <line x1="3" y1="12" x2="7" y2="12"></line>
            <line x1="17" y1="12" x2="21" y2="12"></line>
            <line x1="5.6" y1="5.6" x2="8.5" y2="8.5"></line>
            <line x1="15.5" y1="15.5" x2="18.4" y2="18.4"></line>
            <line x1="18.4" y1="5.6" x2="15.5" y2="8.5"></line>
            <line x1="8.5" y1="15.5" x2="5.6" y2="18.4"></line>
          </svg>
          {highlightsHeading}
        </h2>
        {
          notes.length > 0 && (
            <a
              href={withBase('/notes')}
              class="text-sm font-medium text-teal no-underline hover:underline"
            >
              View all {pluralize(notes.length, 'note')} →
            </a>
          )
        }
      </div>

      <div class="mt-5">
        {
          highlights.length > 0 ? (
            <NoteGrid notes={highlights} />
          ) : (
            <EmptyState title="No notes published yet">
              <p>
                {`${SITE.author} is working through the CS229 ${NOTE_TYPE_CONFIG.lecture.pluralLabel.toLowerCase()} and will publish handwritten notes here as they are finished. `}
                <a href={withBase('/about')}>Read about this project</a> to see how it works.
              </p>
            </EmptyState>
          )
        }
      </div>
    </section>

    <section class="rounded-card border border-border bg-surface-sunk p-6">
      <h2 class="text-xl">About these notes</h2>
      <p class="mt-2 max-w-prose text-muted">
        {
          `${SITE.author} is studying the public 2018 Stanford CS229 lecture series and publishing her original handwritten notes here to keep them organised and easy to revisit. `
        }
        <a href={withBase('/about')}>Read more about the project</a>.
      </p>
    </section>
  </div>
</BaseLayout>
