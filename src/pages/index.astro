---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
---

<BaseLayout>
  <section class="max-w-prose">
    <p class="text-sm font-semibold tracking-wide text-coral-strong uppercase">
      Unofficial learning notes by {SITE.author}
    </p>

    <h1 class="mt-3 text-4xl sm:text-5xl">{SITE.name}</h1>
    <p class="mt-3 font-serif text-xl text-ink-soft sm:text-2xl">{SITE.tagline}</p>

    <p class="mt-6 text-muted">{SITE.description}</p>

    <div
      class="mt-10 rounded-card border border-border bg-surface p-5 text-sm text-muted shadow-card"
    >
      <p class="font-semibold text-ink-soft">Phase 1 scaffold</p>
      <p class="mt-1">
        The design system, layout shell, and accessible navigation are in place. The note library,
        lecture and exercise pages, search, and the PDF reader arrive in later phases.
      </p>
    </div>
  </section>
</BaseLayout>
