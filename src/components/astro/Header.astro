---
import { withBase, isActivePath } from '../../lib/base-path';
import { SITE, NAV_ITEMS } from '../../config/site';

const currentPath = Astro.url.pathname;
---

<header class="site-header relative border-b border-border bg-surface/85 backdrop-blur-sm">
  <div class="shell-container flex items-center justify-between gap-4 py-3.5">
    <a
      href={withBase('/')}
      class="flex items-center gap-2.5 no-underline"
      aria-label={`${SITE.name} — home`}
    >
      <svg
        width="26"
        height="26"
        viewBox="0 0 32 32"
        aria-hidden="true"
        class="shrink-0 text-ink"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path
          d="M16 8c-2.2-1.6-5-2-8-1.6v14C11 20 13.8 20.4 16 22c2.2-1.6 5-2 8-1.6v-14C21 6 18.2 6.4 16 8Z"
        ></path>
        <path d="M16 8v14"></path>
      </svg>
      <span class="font-serif text-lg font-semibold text-ink sm:text-xl">{SITE.name}</span>
    </a>

    <nav class="site-nav" aria-label="Primary" data-site-nav>
      <button
        type="button"
        class="nav-toggle inline-flex items-center gap-2 rounded-md border border-border-strong bg-surface px-3 py-2 text-sm font-semibold text-ink-soft"
        aria-expanded="false"
        aria-controls="primary-nav-list"
        hidden
      >
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        >
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <span>Menu</span>
      </button>

      <ul
        id="primary-nav-list"
        class="nav-list flex flex-col gap-1 text-base md:flex-row md:items-center md:gap-6 md:text-[0.95rem]"
      >
        {
          NAV_ITEMS.map((item) => {
            const active = isActivePath(currentPath, item.href);
            return (
              <li>
                <a
                  href={withBase(item.href)}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'block rounded px-1 py-2 no-underline transition-colors md:py-1',
                    active ? 'font-semibold text-teal' : 'text-ink-soft hover:text-teal',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  // Progressive enhancement: collapse the primary nav behind a "Menu" button on
  // small screens. With JavaScript disabled the button stays hidden and the full
  // nav list stays visible (below the header on mobile), so navigation always
  // works.
  const nav = document.querySelector<HTMLElement>('[data-site-nav]');
  const toggle = nav?.querySelector<HTMLButtonElement>('.nav-toggle');
  const list = nav?.querySelector<HTMLUListElement>('.nav-list');
  const mobile = window.matchMedia('(max-width: 47.999rem)');

  if (nav && toggle && list) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      list.hidden = !open;
    };

    nav.dataset.enhanced = 'true';

    const applyMode = () => {
      if (mobile.matches) {
        toggle.hidden = false;
        setOpen(toggle.getAttribute('aria-expanded') === 'true');
      } else {
        toggle.hidden = true;
        list.hidden = false;
      }
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    list.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a') && mobile.matches) setOpen(false);
    });

    nav.addEventListener('keydown', (event) => {
      if (
        event.key === 'Escape' &&
        mobile.matches &&
        toggle.getAttribute('aria-expanded') === 'true'
      ) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener('click', (event) => {
      if (
        mobile.matches &&
        toggle.getAttribute('aria-expanded') === 'true' &&
        !nav.contains(event.target as Node)
      ) {
        setOpen(false);
      }
    });

    mobile.addEventListener('change', applyMode);
    applyMode();
  }
</script>
