---
import { withBase } from '../../lib/base-path';

interface Crumb {
  label: string;
  /** Site-absolute path (not base-prefixed). Omit for the current page. */
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-sm text-muted">
  <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1">
    {
      items.map((item, index) => (
        <li class="flex items-center gap-1.5">
          {item.href ? (
            <a href={withBase(item.href)} class="text-teal no-underline hover:underline">
              {item.label}
            </a>
          ) : (
            <span aria-current="page" class="text-ink-soft">
              {item.label}
            </span>
          )}
          {index < items.length - 1 && <span aria-hidden="true">/</span>}
        </li>
      ))
    }
  </ol>
</nav>
