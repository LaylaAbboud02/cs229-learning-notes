{
  "name": "cs229-learning-notes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public, unofficial archive of handwritten learning notes for the public 2018 Stanford CS229 lecture series.",
  "license": "MIT",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^24.16.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "add-note": "tsx scripts/add-note.ts",
    "publish-note": "tsx scripts/publish-note.ts",
    "validate-notes": "tsx scripts/validate-notes.ts",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run check && pnpm run test && pnpm run validate-notes && pnpm run build",
    "demo:preview": "node scripts/demo-preview.mjs",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.10",
    "gray-matter": "^4.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-pdf": "^10.5.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@inquirer/prompts": "^8.7.0",
    "@napi-rs/canvas": "^0.1.100",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.12.0",
    "pdfjs-dist": "5.4.296",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
